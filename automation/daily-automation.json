      {
        "parameters": {
          "source": "database",
          "workflowId": {
            "__rl": true,
            "value": "AIJobScoringMock1",
            "mode": "list",
            "cachedResultName": "JobHunter - AI Job Scoring"
          },
          "mode": "once",
          "options": { "waitForSubWorkflow": true }
        },
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.3,
        "position": [1120, 0],
        "id": "run-scoring",
        "name": "Run AI Job Scoring",
        "alwaysOutputData": true,
        "onError": "continueRegularOutput",
        "notes": "AI scoring uses Gemini, then OpenAI, then deterministic fallback."
      },
      {
        "parameters": {
          "jsCode": "const failed = $input.all().some(item => item.json?.error); return [{ json: { ...$('Jooble Status').first().json, scoring_status: failed ? 'failed' : 'completed' } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1340, 0],
        "id": "scoring-status",
        "name": "Scoring Status"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH ranked AS (\n  SELECT id, title, company, city, match_score, ai_recommendation, source_url\n  FROM public.jobs\n  WHERE ai_recommendation IN ('strong_apply', 'apply', 'maybe')\n  ORDER BY match_score DESC NULLS LAST, id DESC\n  LIMIT 10\n)\nSELECT CURRENT_DATE AS digest_date,\n  (SELECT COUNT(*)::int FROM public.jobs WHERE created_at::date = CURRENT_DATE) AS total_new_jobs,\n  (SELECT COUNT(*)::int FROM public.jobs WHERE ai_recommendation = 'strong_apply') AS strong_apply_count,\n  (SELECT COUNT(*)::int FROM public.jobs WHERE ai_recommendation = 'apply') AS apply_count,\n  (SELECT COUNT(*)::int FROM public.jobs WHERE ai_recommendation = 'maybe') AS maybe_count,\n  COALESCE((SELECT jsonb_agg(jsonb_build_object('id', id, 'title', title, 'company', company, 'city', city, 'match_score', match_score, 'recommendation', ai_recommendation, 'source_url', source_url) ORDER BY match_score DESC NULLS LAST, id DESC) FROM ranked), '[]'::jsonb) AS top_jobs;",
          "options": {}
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [1560, 0],
        "id": "fetch-best-jobs",
        "name": "Fetch Best Jobs",
        "credentials": {
          "postgres": { "id": "axBibQduKywez80n", "name": "Postgres account" }
        }
      },
      {
        "parameters": {
          "jsCode": "const status = $('Scoring Status').first().json; return [{ json: { ...$json, ...status, digest_status: 'ready', source_modes: { remotive: 'real_public_api', jooble: 'live_api', scoring: 'gemini_openai_fallback' } } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1780, 0],
        "id": "build-daily-digest",
        "name": "Build Daily Digest"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO public.daily_digests (digest_date, total_new_jobs, strong_apply_count, apply_count, maybe_count, top_jobs)\nVALUES ($1::date, $2, $3, $4, $5, $6::jsonb)\nON CONFLICT (digest_date) DO UPDATE SET\n  total_new_jobs = EXCLUDED.total_new_jobs,\n  strong_apply_count = EXCLUDED.strong_apply_count,\n  apply_count = EXCLUDED.apply_count,\n  maybe_count = EXCLUDED.maybe_count,\n  top_jobs = EXCLUDED.top_jobs\nRETURNING id, digest_date, total_new_jobs, strong_apply_count, apply_count, maybe_count, top_jobs, created_at, 'stored' AS digest_status;",
          "options": {
            "queryReplacement": "={{ [$json.digest_date, $json.total_new_jobs, $json.strong_apply_count, $json.apply_count, $json.maybe_count, JSON.stringify($json.top_jobs)] }}"
          }
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [2000, 0],
        "id": "save-digest",
        "name": "Save Digest",
        "credentials": {
          "postgres": { "id": "axBibQduKywez80n", "name": "Postgres account" }
        }
      },
